# ========================================================
# QualityCheck Log (QCL) Backend Environment Configuration
# ========================================================

PORT=5000
NODE_ENV=development

# --------------------------------------------------------
# DATABASE STORAGE CONFIGURATION (Choose One Option)
# --------------------------------------------------------

# --- OPTION 1: MongoDB Atlas (Recommended for Cloud Production) ---
# 1. Create a free cluster on https://cloud.mongodb.com
# 2. Add a Database User (username & password) under Database Access
# 3. Whitelist your IP (or 0.0.0.0/0) under Network Access
# 4. Uncomment and paste your connection string below:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/qcl_inspection_db?retryWrites=true&w=majority

# --- OPTION 2: Persistent Local MongoDB Service ---
# If you have MongoDB Community Server installed locally on port 27017:
# MONGO_URI=mongodb://127.0.0.1:27017/qcl_inspection_db

# --- OPTION 3: Zero-Config Persistent Local Disk Fallback ---
# If MONGO_URI is omitted or unreachable, QCL automatically activates
# a persistent disk-backed database at: server/data/db
# (Uses WiredTiger storage engine; preserves all data across restarts)
ALLOW_LOCAL_FALLBACK=true

# --------------------------------------------------------
# SEEDING CONFIGURATION
# --------------------------------------------------------
# Set to 'false' if you want a clean database with 0 initial batches.
# When 'true', seeds demo small-batch records ONLY on the first run when DB is empty.
SEED_DEMO_DATA=true

